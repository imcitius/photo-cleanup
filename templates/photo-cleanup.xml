<?xml version="1.0"?>
<!--
  Unraid Community Applications template.

  This is the Community Applications template. Installing from CA needs
  nothing else; to add it by hand, copy this file to
  /boot/config/plugins/dockerMan/templates-user/ on the array, then
  Docker → Add Container → pick "photo-cleanup" from the template list.

  Two things about the mounts are not cosmetic:

  * Mount /mnt/diskN, never /mnt/user. The union filesystem hides which
    physical disk a file is on, and this tool moves files to quarantine with
    rename(2) — which only works inside one filesystem. Through /mnt/user a
    move silently becomes a copy, or fails.
  * The photo shares must be read-write. Quarantine puts a file in a hidden
    .photo-cleanup-quarantine folder in its own directory; nothing is ever
    deleted without a separate confirmation, but the archive is written to.
-->
<Container version="2">
  <Name>photo-cleanup</Name>
  <Repository>ghcr.io/imcitius/photo-cleanup:latest</Repository>
  <Registry>https://github.com/imcitius/photo-cleanup/pkgs/container/photo-cleanup</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/imcitius/photo-cleanup/issues</Support>
  <Project>https://github.com/imcitius/photo-cleanup</Project>
  <Icon>https://raw.githubusercontent.com/imcitius/photo-cleanup/main/assets/icon.png</Icon>
  <TemplateURL>https://raw.githubusercontent.com/imcitius/photo-cleanup/main/templates/photo-cleanup.xml</TemplateURL>
  <License>MIT</License>
  <Overview>
    Sorting out a large photo archive: duplicates and the versions of one
    shot, bursts with the best frame picked out, Lightroom previews and
    caches, and sorting what is left by date. Runs entirely on your server,
    with no internet involved. Nothing is deleted without a confirmation:
    files move to a hidden quarantine folder on the same disk and come back
    with one button. The interface is in English or Russian, switchable in
    Settings.
  </Overview>
  <Category>MediaApp:Photos Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <ExtraParams>--user 99:100</ExtraParams>

  <Config Name="WebUI" Target="8080" Default="8080" Mode="tcp"
          Description="Port for the web interface"
          Type="Port" Display="always" Required="true" Mask="false">8080</Config>

  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/photo-cleanup"
          Description="The index database and the thumbnail cache. Grows by roughly 40 KB per photograph."
          Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/photo-cleanup</Config>

  <Config Name="Archive — disk 1" Target="/mnt/disk1" Default="/mnt/disk1"
          Description="Photographs on the first disk. Read-write: quarantine moves files within the disk."
          Type="Path" Display="always" Required="true" Mask="false" Mode="rw">/mnt/disk1</Config>

  <Config Name="Archive — disk 2" Target="/mnt/disk2" Default=""
          Description="The second array disk, if photographs live there too. Leave empty if not needed."
          Type="Path" Display="always" Required="false" Mask="false" Mode="rw"></Config>

  <Config Name="Archive — disk 3" Target="/mnt/disk3" Default=""
          Description="The third array disk. Leave empty if not needed."
          Type="Path" Display="always" Required="false" Mask="false" Mode="rw"></Config>

  <Config Name="TZ" Target="TZ" Default="Europe/London" Description="Time zone"
          Type="Variable" Display="advanced" Required="false" Mask="false">Europe/London</Config>
</Container>
